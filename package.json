{
  "name": "command-by-extension",
  "displayName": "Command by Extension",
  "description": "Run, automate, and share command workflows for files by extension.",
  "version": "0.10.1",
  "publisher": "local-tools",
  "icon": "resources/extension-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "configuration": {
      "title": "Command by Extension",
      "properties": {
        "commandByExtension.mappings": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Command alternatives for matching file extensions. Use {file}, {files}, {fileName}, {fileNameWithoutExt}, {fileDirname}, {workspaceFolder}, {workspaceName}, {relativePath}, {selectedText}, {clipboard}, {extension}, {timestamp}, {currentLine}, {currentWord}, or {args} as placeholders.",
          "items": {
            "type": "object",
            "required": [
              "extension"
            ],
            "properties": {
              "extension": {
                "type": "string",
                "description": "File extension, such as .py."
              },
              "command": {
                "type": "string",
                "description": "Command to run for this file extension."
              },
              "name": {
                "type": "string",
                "description": "Optional friendly name for the command preset."
              },
              "commands": {
                "type": "array",
                "description": "Alternative commands to choose from when running this file type.",
                "items": {
                  "type": "string"
                }
              },
              "mode": {
                "type": "string",
                "enum": [
                  "terminal",
                  "capture"
                ],
                "default": "terminal",
                "description": "Run in an interactive terminal or capture output in the output channel."
              },
              "problemMatcher": {
                "type": "string",
                "enum": [
                  "none",
                  "gcc",
                  "typescript",
                  "eslint",
                  "shellcheck",
                  "mypy"
                ],
                "default": "none",
                "description": "Parse captured compiler or linter output into clickable Problems."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables for captured or terminal commands."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory. Placeholders are supported."
              },
              "before": {
                "type": "string",
                "description": "Optional command to run before the main command."
              },
              "after": {
                "type": "string",
                "description": "Optional command to run after the main command."
              },
              "saveBeforeRun": {
                "type": "boolean",
                "default": false,
                "description": "Save open modified files before running this mapping."
              },
              "runOnSave": {
                "type": "boolean",
                "default": false,
                "description": "Run automatically when a matching file is saved."
              },
              "runOnCreate": {
                "type": "boolean",
                "default": false,
                "description": "Run automatically when a matching file is created."
              }
            }
          }
        },
        "commandByExtension.workflows": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Named commands that can run without an active file. Supports the same placeholders as file mappings.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Workflow name shown in the Quick Run picker."
              },
              "command": {
                "type": "string",
                "description": "Command to execute."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "terminal",
                  "capture"
                ],
                "default": "terminal"
              },
              "problemMatcher": {
                "type": "string",
                "enum": [
                  "none",
                  "gcc",
                  "typescript",
                  "eslint",
                  "shellcheck",
                  "mypy"
                ],
                "default": "none",
                "description": "Parse captured compiler or linter output into clickable Problems."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "description": "Working directory. Placeholders are supported."
              },
              "before": {
                "type": "string",
                "description": "Optional command to run before the workflow."
              },
              "after": {
                "type": "string",
                "description": "Optional command to run after the workflow."
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "commandByExtension.run",
        "title": "Run Command for File Extension",
        "icon": {
          "light": "resources/run-mapped-command-light.svg",
          "dark": "resources/run-mapped-command-dark.svg"
        }
      },
      {
        "command": "commandByExtension.configure",
        "title": "Configure Commands by File Extension",
        "icon": "$(settings-gear)"
      },
      {
        "command": "commandByExtension.quickRun",
        "title": "Command by Extension: Quick Run"
      },
      {
        "command": "commandByExtension.reRun",
        "title": "Command by Extension: Re-run Last Command"
      },
      {
        "command": "commandByExtension.runFromHistory",
        "title": "Command by Extension: Run from History"
      },
      {
        "command": "commandByExtension.showHistory",
        "title": "Command by Extension: Show Run History"
      },
      {
        "command": "commandByExtension.stopCapturedRun",
        "title": "Command by Extension: Stop Captured Command"
      },
      {
        "command": "commandByExtension.runExplorer",
        "title": "Run Command..."
      },
      {
        "command": "commandByExtension.runSelectedFiles",
        "title": "Command by Extension: Run on Multiple Files"
      },
      {
        "command": "commandByExtension.importMappings",
        "title": "Command by Extension: Import Configuration"
      },
      {
        "command": "commandByExtension.exportMappings",
        "title": "Command by Extension: Export Configuration"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "commandByExtension.run",
          "group": "navigation@1"
        },
        {
          "command": "commandByExtension.configure",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "commandByExtension.runExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "commandByExtension.runExplorer",
          "when": "false"
        }
      ]
    }
  }
}
